{
  "name": "dsh-notifier-ru",
  "version": "0.2.7",
  "description": "Русские уведомления DSH: системные тосты Windows о вопросе, запросе подтверждения, завершении и ошибке задачи, звуки, каналы ntfy/Gotify/Bark/webhook и страница настроек на русском. Форк @wingsky-1/dsh-notifier 0.2.7 (MIT).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "bannerJs": "import { createRequire as __notifierRequire } from \"node:module\";\nconst require = __notifierRequire(import.meta.url);"
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "ru": "Уведомления о ходе работы агента на русском: тост Windows, звук и каналы push (ntfy, Gotify, Bark, webhook), страница настроек на русском.",
        "en": "Task-event notifications in Russian: Windows system toast, sounds and push channels (ntfy, Gotify, Bark, webhook)."
      },
      "capabilities": [
        "connection",
        "notifications"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "wingsky-1 (оригинальный плагин), русская редакция — DSH для 1С",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mempemp/DSH-1C-deskop-bundle.git",
    "directory": "packages/dsh-notifier-ru"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "notification",
    "toast",
    "russian"
  ]
}
